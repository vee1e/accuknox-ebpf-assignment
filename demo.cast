{"version": 2, "width": 80, "height": 24, "timestamp": 1791896525, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "AccuKnox eBPF assignment: TC port drop + cgroup process filter"}
[0.002947, "o", "=== building ===\r\n"]
[0.453451, "o", "=== starting test servers on 4040 and 4050 ===\r\n"]
[1.46057, "o", "\r\n############ Problem 1: drop TCP dport 4040 ############\r\n"]
[2.468769, "o", "--- dial 4040 (expect FAIL) ---\r\n"]
[5.481309, "o", "FAIL 127.0.0.1:4040 comm=demodial err=dial tcp 127.0.0.1:4040: i/o timeout\r\n"]
[5.482743, "o", "--- dial 4050 (expect OK) ---\r\n"]
[5.487791, "o", "OK 127.0.0.1:4050 comm=demodial\r\n"]
[5.488261, "o", "--- p1 log ---\r\n"]
[5.489523, "o", "2026/10/13 13:02:06 p1: dropping TCP dport 4040 on lo; Ctrl-C to detach and restore traffic\r\n"]
[5.511545, "o", "\r\n--- restart p1 with --port 4050: block moves immediately ---\r\n"]
[6.525381, "o", "--- dial 4040 (expect OK now) ---\r\n"]
[6.530354, "o", "OK 127.0.0.1:4040 comm=demodial\r\n"]
[6.530834, "o", "--- dial 4050 (expect FAIL now) ---\r\n"]
[9.543717, "o", "FAIL 127.0.0.1:4050 comm=demodial err=dial tcp 127.0.0.1:4050: i/o timeout\r\n"]
[9.560846, "o", "--- traffic restored after detach ---\r\n"]
[9.564815, "o", "OK 127.0.0.1:4040 comm=demodial\r\n"]
[9.568175, "o", "OK 127.0.0.1:4050 comm=demodial\r\n"]
[9.568652, "o", "\r\n############ Problem 2: myprocess only on 4040 ############\r\n"]
[10.582021, "o", "--- myprocess -> 4040 (expect OK) ---\r\n"]
[10.587462, "o", "OK 127.0.0.1:4040 comm=myprocess\r\n"]
[10.588533, "o", "--- myprocess -> 4050 (expect FAIL) ---\r\n"]
[10.59168, "o", "FAIL 127.0.0.1:4050 comm=myprocess err=dial tcp 127.0.0.1:4050: connect: operation not permitted\r\n"]
[10.592265, "o", "--- otherproc -> 4050 (expect OK, unaffected) ---\r\n"]
[10.59457, "o", "OK 127.0.0.1:4050 comm=otherproc\r\n"]
[10.595256, "o", "--- stopping demo servers so bind tests own the ports ---\r\n"]
[11.602141, "o", "--- myprocess binds 4040 (expect OK) ---\r\n"]
[11.615967, "o", "OK bind 127.0.0.1:4040 comm=myprocess\r\n"]
[11.641199, "o", "--- myprocess binds 58207 (expect FAIL, denied) ---\r\n"]
[11.645771, "o", "FAIL bind 127.0.0.1:58207 comm=myprocess err=listen tcp 127.0.0.1:58207: bind: operation not permitted\r\n"]
[11.64607, "o", "--- otherproc binds 58207 (expect OK, unaffected) ---\r\n"]
[11.64923, "o", "OK bind 127.0.0.1:58207 comm=otherproc\r\n"]
[11.64949, "o", "--- p2 log ---\r\n"]
[11.649905, "o", "2026/10/13 13:02:14 p2: process \"myprocess\" restricted to TCP port 4040 (cgroup /sys/fs/cgroup); Ctrl-C to detach\r\n"]
[11.65253, "o", "\r\n=== demo complete: detach restored all traffic ===\r\n"]
[11.652546, "o", "--- cleaning up ---\r\n"]
